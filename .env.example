# ---------------------------------------------------------------------------
# Lighthouse Curaçao — environment
# Copy to .env.local and fill in. Sections marked (optional) can wait.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# App traffic: the *pooled* connection string (port 6543, pgbouncer).
# Migrations (npm run db:migrate) prefer the direct one (port 5432) — set
# DATABASE_URL to the direct string when running migrations, or run them
# from your own machine.
DATABASE_URL=postgres://postgres:password@db.xxx.supabase.co:5432/postgres

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_MAIL=stay@lighthouse-curacao.com
# Plausible analytics; leave empty to ship no analytics at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Admin (Supabase Auth) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only this account counts as the admin, however many users the project has.
ADMIN_EMAIL=jij@voorbeeld.nl
# (optional, dev only) password login without Supabase; ignored in production.
ADMIN_DEV_PASSWORD=

# --- Payments --------------------------------------------------------------
# Mollie: primary (iDEAL + cards). live_... or test_...
MOLLIE_API_KEY=
# (optional) Mollie signed-webhooks secret; fetch-back verification always runs.
MOLLIE_WEBHOOK_SECRET=
# Stripe: international fallback. Both required to enable Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# (dev/E2E only) enable the fake provider button in the booking flow.
PAYMENT_PROVIDER_FAKE=

# --- E-mail (Resend) -------------------------------------------------------
# Without a key, mails are logged to the console instead of sent.
RESEND_API_KEY=
MAIL_FROM="Lighthouse Curaçao <bevestiging@lighthouse-curacao.com>"

# --- Cron + feeds ----------------------------------------------------------
# Vercel Cron sends this as a Bearer token to /api/cron.
CRON_SECRET=
# Token guarding the outgoing iCal feed URL; empty = public feed.
ICAL_FEED_TOKEN=
