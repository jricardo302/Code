# ---------------------------------------------------------------------------
# IK ZIE, IK ZIE… — voorbeeldconfiguratie
# Kopieer dit bestand naar .env.local en vul in wat je nodig hebt.
#
# Zonder ook maar één variabele draait de site gewoon. Wat er dan níet werkt:
# /beheer blijft dicht, er wordt niet gemaild, er wordt niets gemeten en
# afrekenen kan niet (de wachtlijst wel).
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Volledige URL. Wordt tijdens de BUILD vastgelegd (robots.txt en sitemap.xml
# zijn statisch), dus zet 'm bij je host en niet pas op de draaiende server.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_CONTACT_MAIL=hallo@ikzieikzie.eu
NEXT_PUBLIC_ZAKELIJK_MAIL=teams@ikzieikzie.eu

# Zet op 1 zodra er voorraad is. Zolang dit leeg is toont de productpagina de
# wachtlijst in plaats van een afrekenknop — geen knop die nergens heen gaat.
NEXT_PUBLIC_VERKOOP_OPEN=

# --- Bedrijfsgegevens ------------------------------------------------------
# Zolang deze leeg zijn tonen de juridische pagina's een zichtbare
# plaatshouder. Vul nooit iets in wat niet klopt: een verzonnen KvK-nummer op
# je algemene voorwaarden is erger dan een lege plek.
NEXT_PUBLIC_BEDRIJFSNAAM=
NEXT_PUBLIC_BEDRIJFSADRES=
NEXT_PUBLIC_KVK=
NEXT_PUBLIC_BTW=
NEXT_PUBLIC_TELEFOON=

# --- Beheer ----------------------------------------------------------------
# Wachtwoord voor /beheer. Verplicht als je het overzicht wilt gebruiken.
BEHEER_WACHTWOORD=

# --- Opslag ----------------------------------------------------------------
#   Leeg laten  -> inzendingen komen in data/inzendingen.json (prima lokaal).
#   Ingevuld    -> Postgres. Verplicht op een serverless host: daar is de
#                  schijf tijdelijk en ben je alles bij de volgende deploy kwijt.
# Voorbeeld: postgres://gebruiker:wachtwoord@host/database?sslmode=require
DATABASE_URL=

# Alternatief pad voor het JSON-bestand (relatief t.o.v. de projectmap).
# INZENDINGEN_BESTAND=data/inzendingen.json

# --- Betalen: Stripe -------------------------------------------------------
# Zonder STRIPE_SECRET_KEY werkt de checkout niet en toont de productpagina
# de wachtlijst. De site zelf draait gewoon door.
#
# 1. Maak een account op stripe.com en rond de accountverificatie af.
# 2. Zet in het dashboard onder Settings > Payment methods de methoden aan die
#    je wilt: iDEAL, kaart, Apple Pay, Google Pay. De code noemt ze bewust
#    niet, zodat je ze kunt aan- en uitzetten zonder een deploy.
# 3. Haal de sleutels op bij Developers > API keys.
STRIPE_SECRET_KEY=

# Webhook-geheim. Maak in het dashboard een endpoint aan op
#   https://www.ikzieikzie.eu/api/stripe/webhook
# met alleen de gebeurtenis `checkout.session.completed`, en plak het
# signing secret hieronder. Zonder dit geheim wordt een betaalde bestelling
# NIET vastgelegd — de betaling lukt wel, maar jij ziet 'm niet.
STRIPE_WEBHOOK_SECRET=

# Optioneel: id van een btw-tarief van 21% met "inclusive" gedrag, aan te
# maken onder Product catalogue > Tax rates. Daarmee splitst Stripe de btw uit
# op het betaalbewijs. Laat je 'm leeg, dan wordt het brutobedrag in rekening
# gebracht en verantwoord je de btw zelf in je boekhouding.
STRIPE_BTW_TARIEF_ID=

# Optioneel: als je met een vaste Stripe-prijs wilt werken in plaats van een
# prijs die de server per bestelling opbouwt.
STRIPE_PRICE_INTERVISIE=

# --- Mail: Resend ----------------------------------------------------------
# Zonder RESEND_API_KEY wordt er simpelweg geen mail verstuurd. Inzendingen
# worden dan nog steeds opgeslagen en zijn zichtbaar op /beheer.
RESEND_API_KEY=
# MAIL_AFZENDER moet op een geverifieerd domein zitten.
MAIL_AFZENDER="IK ZIE, IK ZIE… <hallo@ikzieikzie.eu>"
# Krijgt een kopie van elke inzending en bestelling.
MAIL_KOPIE_NAAR=

# --- Meten -----------------------------------------------------------------
# Zolang dit leeg is verschijnt er geen cookiebalk en wordt er niets geladen.
# Is het gevuld, dan vraagt de site eerst toestemming en laadt pas daarna.
NEXT_PUBLIC_GA_ID=

# --- Socials (optioneel, verschijnen alleen als ze gevuld zijn) -------------
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_INSTAGRAM=
