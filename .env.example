# ---------------------------------------------------------------------------
# Ik zie ik zie... — voorbeeldconfiguratie
# Kopieer dit bestand naar .env.local en vul in wat je nodig hebt.
# Zonder deze variabelen draait de site gewoon; alleen /beheer blijft dicht.
# ---------------------------------------------------------------------------

# Wachtwoord voor /beheer. Verplicht als je het overzicht wilt gebruiken.
BEHEER_WACHTWOORD=

# Opslag.
#   Leeg laten  -> aanvragen komen in data/aanvragen.json (prima voor lokaal).
#   Ingevuld    -> Postgres. Verplicht op Vercel: daar is de schijf tijdelijk.
# Voorbeeld: postgres://gebruiker:wachtwoord@host/database?sslmode=require
DATABASE_URL=

# Alternatief pad voor het JSON-bestand (relatief t.o.v. de projectmap).
# AANVRAGEN_BESTAND=data/aanvragen.json

# Volledige URL van de site. Gebruikt voor canonical-links, sitemap en OG-tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contactadres in de footer en op de bevestiging.
NEXT_PUBLIC_CONTACT_MAIL=hallo@ikzieikzie.nl

# --- Optioneel: bevestigingsmail via Resend (https://resend.com) ------------
# Zonder RESEND_API_KEY wordt er simpelweg geen mail verstuurd.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_AFZENDER="Ik zie ik zie... <hallo@jouwdomein.nl>"
# MAIL_KOPIE_NAAR=jij@jouwdomein.nl
